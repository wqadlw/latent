# ============================================================
#  环境变量模板 —— 复制为 .env 并按需修改
#
#  注意：本项目的环境变量由进程直接读取（os.environ），
#  不做 .env 文件自动加载。请通过启动脚本 / 系统服务 / shell export 注入：
#    Windows:  set APP_PORT=8765 && start.bat
#    Linux:    export APP_PORT=8765 && bash start.sh
# ============================================================

# ---------- 服务监听 ----------
# 默认 127.0.0.1（仅本机可访问）。若需局域网访问改为 0.0.0.0，
# 但**务必同时设置 APP_SECRET_KEY 与强密码** —— 否则同网段任何人都能读写数据。
APP_HOST=127.0.0.1
APP_PORT=8765
# 设为 1 可禁止启动时自动打开浏览器
APP_NO_BROWSER=0

# ---------- 安全 ----------
# JWT 签名密钥。留空则自动生成并落盘到 backend/data/.secret_key。
# 多实例部署或需要令牌跨重启稳定时，显式指定一个高强度随机串。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# 登录令牌有效期（秒），默认 43200 = 12 小时
APP_TOKEN_TTL=43200

# 敏感字段加密密钥（Fernet，44 位 base64）。
# 留空则自动生成并落盘到 backend/data/.fernet_key。
# ⚠️ 更换此密钥会导致已加密的 API Key / 平台凭据无法解密，需重新录入。
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_FERNET_KEY=

# ---------- 跨域 ----------
# 前后端同源单体部署无需设置。仅当独立部署前端时需要，逗号分隔。
# 例：BACKEND_CORS_ORIGINS=https://content.example.com,https://admin.example.com
BACKEND_CORS_ORIGINS=

# ---------- 数据库 ----------
# 留空则使用 backend/data/database.db
APP_DB_PATH=

# ---------- 品牌配置（也可改用 brand.config.json）----------
BRAND_NAME=
BRAND_FULL_NAME=
BRAND_PRODUCT=
BRAND_OFFICIAL_SITE_URL=
BRAND_REGION=
BRAND_REGION_CITY=
BRAND_ALIASES=
