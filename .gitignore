# ============================================================
#  开源仓库 .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- Node / 前端 ----------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 构建产物 ----------
# 后端 PyInstaller 打包产物
backend/build/
backend/dist/
*.manifest
# 前端 Vite 构建产物
frontend/dist/
frontend/dist-p3/
# 后端托管的已构建前端
backend/static/assets/
backend/static/index.html
# Vite 临时配置快照
vite.config.js.timestamp-*.mjs

# ---------- 运行时数据 ----------
# 含真实业务数据、LLM API Key、平台登录凭据、用户密码，务必不要提交
backend/data/

# ---------- 演示数据（截图 / 试用用） ----------
# 由 backend/scripts/seed_demo.py 灌出的虚构品牌数据集，属可再生的一次性产物。
# 之所以不提交：它是从开发库 VACUUM 出来的快照再清空，体积大且随时可重建。
.demo/

# ---------- 环境变量 ----------
# 含 JWT 签名密钥与加密密钥，泄露等于泄露全部已加密数据
.env
.env.local
*.env.bak

# ---------- 品牌定制配置 ----------
# 客户部署时填写的真实品牌信息（品牌名/官网/地域），属私有配置，不对外发布。
# 仓库只保留模板 brand.config.json.example，使用者复制后自行填写。
brand.config.json
backend/brand.config.json

# ---------- 日志 ----------
*.log
*.err
logs/

# ---------- 内部文档 ----------
# 含客户信息与内部调试过程，不对外发布
HANDOFF.md
ARCHITECTURE_REVIEW.md
docs/系统整体审查_*.md

# ---------- 含真实数据的截图 ----------
frontend/knowledge-verify.png

# ---------- 内部验收截图 ----------
# docs/screenshots/ 下 01-09 是 README 用的产品预览图（对着演示库截图），随仓库发布。
# 其余前缀（B4- / C- / D2-…D7- / geo-visibility- / 品牌-）是各阶段本地验收证据：
# 对着开发库截图，含内部业务内容与调试标记数据，只在本地留存，不对外发布。
docs/screenshots/B4-*.png
docs/screenshots/C-*.png
docs/screenshots/D[0-9]-*.png
docs/screenshots/geo-visibility-*.png
docs/screenshots/品牌-*.png

# ---------- AI 协作目录 ----------
.workbuddy/
.workbuddy-ai/
.reasonix/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
