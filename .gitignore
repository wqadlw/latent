# ============================================================
#  开源仓库 .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- Node / 前端 ----------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 构建产物 ----------
# 后端 PyInstaller 打包产物
backend/build/
backend/dist/
*.manifest
# 前端 Vite 构建产物
frontend/dist/
frontend/dist-p3/
# 后端托管的已构建前端
backend/static/assets/
backend/static/index.html
# Vite 临时配置快照
vite.config.js.timestamp-*.mjs

# ---------- 运行时数据 ----------
# 含真实业务数据、LLM API Key、平台登录凭据、用户密码，务必不要提交
backend/data/

# ---------- 品牌定制配置 ----------
# 客户部署时填写的真实品牌信息（品牌名/官网/地域），属私有配置，不对外发布。
# 仓库只保留模板 brand.config.json.example，使用者复制后自行填写。
brand.config.json
backend/brand.config.json

# ---------- 日志 ----------
*.log
*.err
logs/

# ---------- 内部文档 ----------
# 含客户信息与内部调试过程，不对外发布
HANDOFF.md
ARCHITECTURE_REVIEW.md
docs/系统整体审查_*.md

# ---------- 含真实数据的截图 ----------
frontend/knowledge-verify.png

# ---------- AI 协作目录 ----------
.workbuddy/
.workbuddy-ai/
.reasonix/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
